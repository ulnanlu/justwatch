{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automerge": false,
  "dependencyDashboard": true,
  "schedule": [
    "every weekend"
  ],
  "labels": [
    "dependencies"
  ],
  "branchPrefix": "deps/",
  "commitMessagePrefix": "chore(deps): ",
  "prHourlyLimit": 2,
  "prConcurrentLimit": 10,
  "minimumReleaseAge": "3 days"
}
